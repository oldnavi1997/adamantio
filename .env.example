DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/luminus?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="luminus-products"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
ALGOLIA_ADMIN_KEY=
# Correo transaccional: se envía con Resend (lib/email.ts). Las dos variables
# de abajo son obligatorias o el correo de confirmación no sale.
RESEND_API_KEY=
# Tiene que ser una dirección de un dominio verificado en resend.com/domains.
# `onboarding@resend.dev` NO sirve en producción: solo entrega al dueño de la
# cuenta de Resend, al resto de destinatarios los rechaza.
EMAIL_FROM=pedidos@adamantio.pe

# Buzón interno que recibe el aviso de cada hoja del Libro de Reclamaciones.
# Si queda vacío, la copia igual le llega al consumidor pero nadie se entera
# internamente del reclamo.
COMPLAINTS_EMAIL=adamantio@gmail.com

# ─── Izipay (pasarela Lyra/Krypton V4) ───
# Back Office → Configuración → Tienda → Claves de API REST.
# Adamantio necesita SU PROPIA tienda Izipay: la regla de notificación (IPN) es
# una por tienda, así que no se puede compartir con Luminus.
# Si falta cualquiera de las cuatro, la pestaña Izipay del checkout no aparece.
IZIPAY_API_URL="https://api.micuentaweb.pe"
IZIPAY_USERNAME=       # usuario / shopId
IZIPAY_PASSWORD=       # contraseña REST; TAMBIÉN valida el kr-hash del IPN
IZIPAY_PUBLIC_KEY=     # clave pública, con el prefijo del shopId
IZIPAY_HMAC_SHA256=    # clave HMAC-SHA-256; valida el kr-hash del navegador
