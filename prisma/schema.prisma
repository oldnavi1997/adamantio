generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  VENDEDOR
}

enum Categoria {
  ANILLO
  COLLAR
  PULSERA
  ARETE
  OTRO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  YAPE
  PLIN
}

enum Genero {
  HOMBRE
  MUJER
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  SHIPPED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  addresses     Address[]
  refreshTokens RefreshToken[]
  sales         Sale[]
  stockEntries  StockEntry[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Product {
  id               String      @id @default(cuid())
  name             String
  description      String
  imageUrl         String?
  imageUrls        String[]    @default([])
  contentImages    String[]    @default([])
  productDetails   String      @default("")
  sizeInfo         String      @default("")
  category         String?
  categoryId       String?
  categoryRef      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price            Decimal     @db.Decimal(10, 2)
  stock            Int
  sku              String?     @unique
  sizes            String[]    @default([])
  isActive         Boolean     @default(true)
  engravingEnabled Boolean     @default(false)
  engravingImages  String[]    @default([])
  freeShipping     Boolean     @default(false)
  testMode         Boolean     @default(false)
  esPar            Boolean     @default(false)

  // ─── Campos POS ───────────────────────────────────
  categoria          Categoria?
  genero             Genero[]    @default([])
  precioCosto        Float?
  precioVentaHombre  Float       @default(0)
  precioVentaMujer   Float       @default(0)
  precioVentaPareja  Float       @default(0)
  stockMinimo        Int         @default(5)
  stockHombre        Int         @default(0)
  stockMujer         Int         @default(0)
  stockAlmacen       Int         @default(0)
  stockAlmacenHombre Int         @default(0)
  stockAlmacenMujer  Int         @default(0)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
  saleItems        SaleItem[]
  stockEntries     StockEntry[]
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Category {
  id        String     @id
  name      String     @unique
  parentId  String?    @map("parent_id")
  sortOrder Int        @default(0)  @map("sort_order")
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @map("updated_at")

  @@map("categories")
}

model Address {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String
  phone          String
  documentType   String   @default("")
  documentNumber String   @default("")
  street         String
  district       String   @default("")
  city           String
  state          String
  postalCode     String
  country        String
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  addressId    String?
  address      Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  guestEmail   String?
  total        Decimal     @db.Decimal(10, 2)
  shippingCost Decimal     @default(0) @db.Decimal(10, 2)
  /// Comisión de la pasarela trasladada al comprador. Se llama `mp*` por
  /// herencia de Mercado Pago, pero la escribe cualquier proveedor.
  mpCommission Decimal     @default(0) @db.Decimal(10, 2)
  /// Pasarela con la que se cobró: "mercadopago" | "izipay".
  paymentProvider String   @default("mercadopago")
  status       OrderStatus @default(PENDING)
  /// Guarda de idempotencia. Un único `updateMany` sobre este flag decide quién
  /// aprueba la orden: con Izipay, la respuesta del navegador y el IPN compiten
  /// en cada venta y sin esto el stock se descontaría dos veces.
  stockDeducted Boolean    @default(false)
  stockNote    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]
  payments     Payment[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  productPrice  Decimal  @db.Decimal(10, 2)
  quantity      Int
  engravingText String?
  selectedSize  String?
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalReference String        @unique
  mpPreferenceId    String?
  mpPaymentId       String?
  paymentMethodId   String?
  statusDetail      String?
  idempotencyKey    String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// ─── Modelos POS ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
}

model Sale {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  subtotal      Float
  descuento     Float      @default(0)
  total         Float
  metodoPago    MetodoPago
  montoRecibido Float?
  cambio        Float?
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  cantidad       Int
  precioUnitario Float
  descuento      Float    @default(0)
  subtotal       Float
  generoVenta    String?
}

model StockEntry {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  cantidad  Int
  costo     Float?
  nota      String?
  createdAt DateTime @default(now())
}

// Expo push tokens registered by the POS mobile app. Written by the POS
// backend (/api/push-tokens), read here to notify devices when an order is paid.
model PushToken {
  token     String   @id
  userId    String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Libro de Reclamaciones (Indecopi, D.S. 011-2011-PCM y modificatorias) ---
// El reglamento distingue reclamo (disconformidad con el producto o servicio)
// de queja (malestar por la atención), exige numeración correlativa y obliga a
// conservar la hoja por dos años, por eso se persiste en vez de solo mandar un
// correo.
enum ComplaintType {
  RECLAMO
  QUEJA
}

enum ComplaintGoodType {
  PRODUCTO
  SERVICIO
}

enum ComplaintStatus {
  PENDIENTE
  RESPONDIDO
}

model Complaint {
  id     String @id @default(cuid())
  // Correlativo de la hoja. Un serial de Postgres evita que dos envíos
  // simultáneos reciban el mismo número.
  number Int    @unique @default(autoincrement())

  // 1. Identificación del consumidor reclamante
  fullName     String
  documentType String
  documentId   String
  phone        String
  email        String
  department   String
  province     String
  district     String
  address      String
  reference    String?

  // Menor de edad: el reglamento pide los datos del padre o apoderado
  isMinor           Boolean @default(false)
  guardianFullName  String?
  guardianDocType   String?
  guardianDocId     String?
  guardianPhone     String?

  // 2. Identificación del bien contratado
  goodType    ComplaintGoodType
  orderNumber String?
  incidentAt  DateTime?
  amount      Decimal?          @db.Decimal(10, 2)
  goodDetail  String

  // 3. Detalle de la reclamación
  type    ComplaintType
  detail  String
  request String

  // 4. Acciones adoptadas por el proveedor
  status     ComplaintStatus @default(PENDIENTE)
  response   String?
  respondedAt DateTime?
  // Plazo legal de respuesta: 15 días hábiles desde la presentación.
  dueAt      DateTime

  // Trazabilidad de la copia que exige remitirse al consumidor
  copySentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("complaints")
}
